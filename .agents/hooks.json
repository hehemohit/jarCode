{
  "remote-approval-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./packages/hook-client/dist/index.js",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
