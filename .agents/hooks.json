{
  "remote-approval-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p = require('fs').existsSync('./packages/hook-client/dist/index.js') ? './packages/hook-client/dist/index.js' : '../packages/hook-client/dist/index.js'; require(require('path').resolve(p));\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
